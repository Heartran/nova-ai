# Copia questo file in .env e riempi i valori veri.
# .env e' nel .gitignore, non finisce su git.

# Token del bot Discord (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=il-tuo-token-discord

# API Key di Anthropic (opzionale se usi il login via CLI `claude`)
ANTHROPIC_API_KEY=

# Modello Claude da usare. L'autenticazione passa dal tuo login claude.ai
# (richiesto: Claude Code CLI installato e loggato — `claude` nel PATH).
CLAUDE_MODEL=claude-sonnet-4-6

# Path della memoria dedicata a Nova (relativo al repo o assoluto).
# Se la cartella non esiste, viene creata al primo avvio copiando
# `memory.example/` come template.
NOVA_MEMORY_DIR=./memory

# Path assoluto della auto-memory utente di Claude (read-only per Nova)
USER_MEMORY_DIR=

# --- WhatsApp Configuration ---
# Path assoluto al database messages.db del bridge Go
WHATSAPP_BRIDGE_DB=
# URL base delle API del bridge (default: http://localhost:8080/api)
WHATSAPP_API_URL=http://localhost:8080/api
# Intervallo di polling in secondi (default: 5)
WHATSAPP_POLL_INTERVAL=5
# Messaggi di storico da includere nel contesto (default: 20)
WHATSAPP_HISTORY_LIMIT=20

# Quanti messaggi recenti del canale includere come contesto
HISTORY_MESSAGES=10

# Cooldown minimo (secondi) tra una risposta e l'altra nello stesso canale
CHANNEL_COOLDOWN_SECONDS=2

# Lunghezza massima risposta (Discord limita a 2000, lasciamo margine)
MAX_RESPONSE_CHARS=1900

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# (Opzionale) Path assoluto al JSON di mappatura contatti WhatsApp (phone↔LID).
# Non tracciato da git — metti il path reale nel tuo .env locale.
# WHATSAPP_CONTACT_MAP=

# --- Whisper / Trascrizione vocali ---
# Provider: 'groq' (default, free tier) o 'openai'
WHISPER_PROVIDER=groq
# Groq API key (https://console.groq.com/keys) — necessaria con WHISPER_PROVIDER=groq
GROQ_API_KEY=
# OpenAI API key — necessaria con WHISPER_PROVIDER=openai
# OPENAI_API_KEY=

# --- Voce / Canale vocale (comandi /voce) ---
# Nova entra in un canale vocale, ascolta (STT), pensa con Claude tenendo
# personalita', memoria e TUTTI i suoi tool, e risponde a voce (TTS ElevenLabs).
#
# TTS (voce di Nova) — ElevenLabs:
ELEVENLABS_API_KEY=
# Voice ID della voce da usare (lo trovi nella Voice Library di ElevenLabs).
ELEVENLABS_VOICE_ID=
# Modello: eleven_flash_v2_5 (bassa latenza) o eleven_multilingual_v2 (qualita').
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Formato audio. pcm_48000 = playback diretto senza ffmpeg (consigliato).
# Altri formati (es. mp3_44100_128) richiedono ffmpeg installato.
ELEVENLABS_OUTPUT_FORMAT=pcm_48000
#
# STT (Nova ti ascolta) — default: riusa WHISPER_PROVIDER/GROQ_API_KEY qui sopra.
# Imposta 'elevenlabs' per usare ElevenLabs Scribe, 'groq' o 'openai' altrimenti.
VOICE_STT_PROVIDER=
# Lingua per STT e TTS (codice ISO, es. it, en).
VOICE_LANGUAGE=it
#
# Tuning conversazione vocale:
# Silenzio (ms) dopo cui una battuta e' considerata finita.
VOICE_SILENCE_MS=900
# Durata minima (ms) di una battuta per essere trascritta (ignora i rumori).
VOICE_MIN_UTTERANCE_MS=400
# Soglia di energia per il barge-in (Nova smette di parlare se la interrompi).
VOICE_ENERGY_THRESHOLD=350
# Quanti turni di conversazione vocale tenere a mente nella sessione.
VOICE_HISTORY_TURNS=8
