# Copia questo file in .env e riempi i valori veri.
# .env e' nel .gitignore, non finisce su git.

# Token del bot Discord (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=il-tuo-token-discord

# Modello Claude da usare. L'autenticazione passa dal tuo login claude.ai
# (richiesto: Claude Code CLI installato e loggato — `claude` nel PATH).
CLAUDE_MODEL=claude-sonnet-4-6

# Path assoluto della memoria FNAC dedicata a Nova
NOVA_MEMORY_DIR=C:\Users\Federico\OneDrive\Documenti\Claude\Projects\Five Nights At Catanzaro's\nova_memory

# Path assoluto della auto-memory utente di Claude (read-only per Nova)
USER_MEMORY_DIR=C:\Users\Federico\AppData\Roaming\Claude\local-agent-mode-sessions\bae36e77-b092-49eb-8ff5-83360b2e81b4\1c915857-36cf-4b4c-b208-2a7ad10e2f26\spaces\25e1f0ba-0c4a-44a7-b6fe-895dc95a771f\memory

# Quanti messaggi recenti del canale includere come contesto
HISTORY_MESSAGES=10

# Cooldown minimo (secondi) tra una risposta e l'altra nello stesso canale
CHANNEL_COOLDOWN_SECONDS=2

# Lunghezza massima risposta (Discord limita a 2000, lasciamo margine)
MAX_RESPONSE_CHARS=1900

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
